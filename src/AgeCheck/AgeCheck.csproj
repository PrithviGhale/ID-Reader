<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgeCheck.Core\AgeCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Required for the compiler-generated Windows interop stub in Theme. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>AgeCheck.App</StartupObject>
    <ApplicationIcon>Assets/AgeCheck.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>AgeCheck</Company>
    <Authors>AgeCheck</Authors>
    <Product>AgeCheck</Product>
    <Copyright>Copyright © 2026 AgeCheck contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets/Logo.png" />
    <Resource Include="Assets/AgeCheck.ico" />
    <Content Include="../../release-config.json" Link="release-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
