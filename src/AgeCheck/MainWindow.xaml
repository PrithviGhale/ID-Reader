<Window x:Class="AgeCheck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AgeCheck" Width="1080" Height="860" MinWidth="480" MinHeight="480" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid x:Name="RootLayout" Background="{DynamicResource Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface}" Padding="24,18,24,12">
   <StackPanel>
    <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Border x:Name="BrandMark" Width="37" Height="37" Background="{DynamicResource Accent}" CornerRadius="12"><TextBlock Text="A" Foreground="{DynamicResource AccentInk}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="AgeCheck" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="A little clarity at the counter." Style="{StaticResource Caption}" FontSize="10"/></StackPanel></StackPanel>
     <Border x:Name="LocalBadge" Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="16" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="●  LOCAL &amp; PRIVATE" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="Bold"/></Border>
    </Grid>
    <WrapPanel>
     <Button x:Name="ScanNav" Content="Scan" Click="ScanPage_Click" Padding="22,9" Margin="0,0,6,3"/>
     <Button x:Name="SetupNav" Content="Setup" Click="SetupPage_Click" Padding="22,9" Margin="0,0,6,3"/>
     <Button x:Name="UpdatesNav" Content="Updates" Click="UpdatesPage_Click" Padding="22,9" Margin="0,0,6,3"/>
     <Button x:Name="SettingsNav" Content="Settings" Click="SettingsPage_Click" Padding="22,9" Margin="0,0,0,3"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
   <Grid x:Name="PageHost" Margin="34,26" MaxWidth="1080" HorizontalAlignment="Stretch">
    <StackPanel x:Name="ScanPage">
     <TextBlock Text="Ready when you are." Style="{StaticResource PageHeading}"/>
     <TextBlock Text="Scan the barcode. Compare the card. Clear for the next customer." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
     <Border x:Name="ResultCard" Style="{StaticResource Card}">
      <StackPanel>
       <WrapPanel Margin="0,0,0,24"><Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="10,6" Margin="0,0,10,5"><TextBlock x:Name="Phase" Text="READY TO SCAN" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="Bold"/></Border><TextBlock x:Name="DemoBadge" Text="DEMO · MADE-UP DATA" Foreground="{DynamicResource WarmInk}" FontWeight="Bold" FontSize="11" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,5"/></WrapPanel>
       <Grid x:Name="ResultLayout">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ResultTextColumn" Width="*"/><ColumnDefinition x:Name="ResultDatesColumn" Width="268"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="ResultSummary" Margin="0,0,28,0">
         <Border x:Name="SymbolBox" Width="74" Height="74" Background="{DynamicResource AccentSoft}" CornerRadius="25" HorizontalAlignment="Left" Margin="0,0,0,22"><TextBlock x:Name="Symbol" Text="⌁" FontSize="42" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock x:Name="Headline" Text="Ready to scan" FontSize="38" FontWeight="SemiBold"/>
         <TextBlock x:Name="ResultSubtitle" Text="Aim at the barcode on the back of the card." FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
         <TextBlock x:Name="Detail" Text="Keep this window active. Your result appears here." FontSize="13" Foreground="{DynamicResource Muted}" LineHeight="21" Margin="0,15,0,0"/>
        </StackPanel>
        <Border x:Name="DatesPanel" Grid.Column="1" Background="{DynamicResource Inset}" CornerRadius="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22" VerticalAlignment="Top">
         <StackPanel>
          <TextBlock Text="CHECK AGAINST THE CARD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,23"/>
          <TextBlock Text="Date of birth" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="BirthLabel" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,20"/>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,20"/>
          <TextBlock Text="Expiration date" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="ExpiryLabel" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
         </StackPanel>
        </Border>
       </Grid>
       <Border x:Name="RecoveryNotice" Background="{DynamicResource Warm}" CornerRadius="12" Padding="18" Margin="0,24,0,0" Visibility="Collapsed">
        <StackPanel><TextBlock Text="One quick comparison" FontWeight="SemiBold" Foreground="{DynamicResource WarmInk}"/><TextBlock Text="Check both displayed dates against the printed card before continuing. The scanner changed the barcode formatting." Foreground="{DynamicResource WarmInk}" Margin="0,6,0,15"/><Button x:Name="ConfirmDatesButton" Content="Both dates match the card" Click="ConfirmDates_Click" Background="{DynamicResource WarmInk}" Foreground="{DynamicResource Canvas}" HorizontalAlignment="Left"/></StackPanel>
       </Border>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,27,0,0" Padding="0,20,0,0">
        <WrapPanel><Button x:Name="ClearButton" Content="Next customer   →" Click="Clear_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Margin="0,0,18,8"/><TextBlock Text="Auto-clears after 30 seconds&#10;and when you leave the window" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
       </Border>
      </StackPanel>
     </Border>
     <WrapPanel Margin="0,20,0,4"><TextBlock Text="TRY IT" Style="{StaticResource Caption}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,8"/><Button Content="21+" Click="AdultDemo_Click" Padding="16,9" Margin="0,0,8,8"/><Button Content="Under 21" Click="YoungDemo_Click" Padding="16,9" Margin="0,0,8,8"/><Button Content="Expired" Click="ExpiredDemo_Click" Padding="16,9" Margin="0,0,8,8"/><Button Content="Scanner sample" Click="RecoveryDemo_Click" Padding="16,9" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="No scan history. No cloud processing. USB keyboard input." Style="{StaticResource Caption}" FontSize="11"/>
     <TextBlock Text="Scanner connection is not detected in keyboard mode." Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel x:Name="SetupPage" Visibility="Collapsed">
     <TextBlock Text="A better first scan." Style="{StaticResource PageHeading}"/><TextBlock Text="Set up once, then keep the counter moving." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Honeywell Xenon XP 1950g" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="01   Match the keyboard" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" Margin="0,25,0,8"/><TextBlock Text="Use USB PC Keyboard mode, enable PDF417, and match the scanner keyboard country to Windows. A mismatch can change characters or combine accents in the header." Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="02   Preserve the whole barcode" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" Margin="0,25,0,8"/><TextBlock Text="Enable Control Character Output using text such as [LF], [CR] and [RS] for full validation. Turn off data editing and extra prefixes. Use the manual for your firmware." Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="03   If your scanner sends one long line" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" Margin="0,25,0,8"/><TextBlock Text="Supported flattened headers and the known accented header variation can use date recovery. Compare the displayed dates with the printed card, then confirm. Missing or conflicting dates still require manual review." Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="04   Keep AgeCheck active" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" Margin="0,25,0,8"/><TextBlock Text="Open Scan. The app waits for 700 ms of silence; a line break never submits early. A beep only means the scanner decoded something. Never share real ID barcodes in a support report." Foreground="{DynamicResource Muted}"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
     <TextBlock Text="Fresh features. Your timing." Style="{StaticResource PageHeading}"/><TextBlock Text="Download in the background. Restart when the counter is clear." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="AgeCheck for Windows" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="UpdateStatus" Text="Check for stable releases from the official repository." Foreground="{DynamicResource Muted}" Margin="0,14,0,24"/>
      <CheckBox x:Name="StartupChecks" IsChecked="True" Click="StartupChecks_Click" Margin="0,0,0,22"><TextBlock Text="Check for updates at startup"/></CheckBox>
      <WrapPanel><Button x:Name="CheckButton" Content="Check for updates" Click="CheckUpdates_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Margin="0,0,10,10"/><Button x:Name="DownloadButton" Content="Download update" Click="Download_Click" IsEnabled="False" Margin="0,0,10,10"/><Button x:Name="RestartButton" Content="Update and restart" Click="Restart_Click" IsEnabled="False" Margin="0,0,0,10"/></WrapPanel>
      <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="5" Margin="0,10,0,24" Foreground="{DynamicResource Accent}" Background="{DynamicResource Quiet}" BorderThickness="0"/>
      <TextBlock Text="RELEASE NOTES" Style="{StaticResource Caption}" FontSize="10" FontWeight="Bold"/>
      <TextBlock x:Name="ReleaseNotes" Text="No update selected." Foreground="{DynamicResource Muted}" Margin="0,12,0,24"/>
      <Button Content="Later — back to scanning" Click="ScanPage_Click" HorizontalAlignment="Left"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
     <TextBlock Text="Make it feel like yours." Style="{StaticResource PageHeading}"/><TextBlock Text="Small preferences. A more comfortable workday." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose the look that suits your counter." Foreground="{DynamicResource Muted}" Margin="0,7,0,20"/>
      <WrapPanel><Button x:Name="LightThemeButton" Content="☀  Light" Click="LightTheme_Click" Padding="28,18" Margin="0,0,12,12"/><Button x:Name="DarkThemeButton" Content="☾  Dark" Click="DarkTheme_Click" Padding="28,18" Margin="0,0,0,12"/></WrapPanel>
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,24"/>
      <TextBlock Text="Motion" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="A brief opening reveal and gentle transitions between pages." Foreground="{DynamicResource Muted}" Margin="0,7,0,20"/>
      <CheckBox x:Name="MotionEnabled" IsChecked="True" Click="MotionEnabled_Click"><TextBlock Text="Enable animations"/></CheckBox>
      <TextBlock Text="Animations also respect your Windows animation setting. They stop when each transition finishes." Style="{StaticResource Caption}" Margin="0,13,0,24"/>
      <TextBlock x:Name="SettingsStatus" Text="Preferences save on this PC. ID data is never saved." Foreground="{DynamicResource Muted}"/>
     </StackPanel></Border>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,13">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ID authenticity not verified." FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Compare the printed card, photograph and customer. A barcode result does not approve a sale." Style="{StaticResource Caption}" FontSize="10" Margin="0,4,12,0"/></StackPanel><TextBlock x:Name="VersionLabel" Grid.Column="1" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center"/></Grid>
  </Border>
 </Grid>
</Window>
