<Window x:Class="AgeCheck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AgeCheck" Width="1120" Height="800" MinWidth="920" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F4F6F3" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142D2C" Padding="24,32">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Border Background="#A9E8CC" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Left"><TextBlock Text="A" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="AgeCheck" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,15,0,3"/>
     <TextBlock Text="A little more certainty." Foreground="#ABC4BE" FontSize="12" Margin="0,0,0,38"/>
     <Button Content="Scan an ID" Click="ScanPage_Click" HorizontalContentAlignment="Left" Background="#A9E8CC" Margin="0,0,0,10"/>
     <Button Content="Scanner setup" Click="SetupPage_Click" HorizontalContentAlignment="Left" Background="#24413F" Foreground="#E2EEEA" Margin="0,0,0,10"/>
     <Button Content="App updates" Click="UpdatesPage_Click" HorizontalContentAlignment="Left" Background="#24413F" Foreground="#E2EEEA"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="PRIVATE BY DESIGN" Foreground="#A9E8CC" FontSize="10" FontWeight="Bold" Margin="0,0,0,9"/>
     <TextBlock Text="Checks stay on this PC.&#10;No scan history is saved." Foreground="#ABC4BE" FontSize="12" LineHeight="20"/>
     <TextBlock x:Name="VersionLabel" Foreground="#ABC4BE" FontSize="11" Margin="0,22,0,0"/>
    </StackPanel><Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="36,30,36,22">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="ScanPage">
      <DockPanel Margin="0,0,0,24"><Border DockPanel.Dock="Right" Background="#E4ECE6" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="LOCAL • OFFLINE READY" FontSize="10" FontWeight="Bold" Foreground="#3C6457"/></Border><StackPanel><TextBlock Text="THE EVERYDAY CHECK" FontSize="10" FontWeight="Bold" Foreground="#64766D"/><TextBlock Text="One scan. A clearer answer." FontSize="27" FontWeight="SemiBold" Margin="0,6,10,0"/></StackPanel></DockPanel>
      <Border x:Name="ResultCard" Background="White" BorderBrush="#DDE5DF" BorderThickness="1" CornerRadius="20" Padding="30">
       <StackPanel>
        <DockPanel><TextBlock x:Name="Phase" Text="READY" Foreground="#4C7565" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="DemoBadge" Text="DEMO • SYNTHETIC DATA" Foreground="#935E0B" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed"/></DockPanel>
        <Border x:Name="SymbolBox" Background="#E6F5EC" Width="70" Height="70" CornerRadius="22" HorizontalAlignment="Left" Margin="0,28,0,20"><TextBlock x:Name="Symbol" Text="↗" FontSize="36" Foreground="#237557" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock x:Name="Headline" Text="Ready to scan" FontSize="36" FontWeight="SemiBold" LineHeight="43"/>
        <TextBlock x:Name="Detail" Text="Keep this window active and scan the barcode on the back of the ID." Foreground="#61726B" FontSize="15" LineHeight="24" Margin="0,12,0,24"/>
        <Border Background="#F4F7F4" CornerRadius="12" Padding="18" Margin="0,0,0,24">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="BIRTH DATE" FontSize="10" Foreground="#66796E" FontWeight="Bold"/><TextBlock x:Name="BirthLabel" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="EXPIRATION DATE" FontSize="10" Foreground="#66796E" FontWeight="Bold"/><TextBlock x:Name="ExpiryLabel" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
         </Grid>
        </Border>
        <DockPanel><Button Content="Clear / Next customer  →" Background="#176B53" Foreground="White" Click="Clear_Click" DockPanel.Dock="Left"/><TextBlock Text="Auto-clears after 30 seconds&#10;and when you leave this window" FontSize="11" Foreground="#6A7A71" TextAlignment="Right" VerticalAlignment="Center" Margin="15,0,0,0"/></DockPanel>
       </StackPanel>
      </Border>
      <DockPanel Margin="0,18,0,0"><TextBlock Text="Try a synthetic demo" Foreground="#687B70" VerticalAlignment="Center" Margin="0,0,14,0"/><StackPanel Orientation="Horizontal"><Button Content="21+" Click="AdultDemo_Click" Padding="17,9" Margin="0,0,8,0"/><Button Content="Under 21" Click="YoungDemo_Click" Padding="17,9" Margin="0,0,8,0"/><Button Content="Expired" Click="ExpiredDemo_Click" Padding="17,9"/></StackPanel></DockPanel>
      <TextBlock Text="USB keyboard input • Scanner connection is not detected" FontSize="11" Foreground="#748277" Margin="0,16,0,8"/>
     </StackPanel>
     <StackPanel x:Name="SetupPage" Visibility="Collapsed">
      <TextBlock Text="Make the first scan count." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,24"/>
      <Border Background="White" CornerRadius="18" Padding="28"><StackPanel>
       <TextBlock Text="Honeywell Xenon XP 1950g" FontSize="21" FontWeight="SemiBold"/>
       <TextBlock Text="01   Use USB PC Keyboard mode" FontWeight="SemiBold" Margin="0,24,0,8"/>
       <TextBlock Text="Match the scanner keyboard country to Windows. Enable PDF417. Use the Honeywell user guide for your exact firmware; do not use programming barcodes from unrelated models."/>
       <TextBlock Text="02   Preserve the entire barcode" FontWeight="SemiBold" Margin="0,24,0,8"/>
       <TextBlock Text="Enable Control Character Output (text substitutions such as [LF], [CR] and [RS]). Turn off data editing and extra prefixes; a ]L0 symbology prefix is accepted. A trailing Enter or Tab is okay. Do not strip line breaks."/>
       <TextBlock Text="03   Return to Scan an ID" FontWeight="SemiBold" Margin="0,24,0,8"/>
       <TextBlock Text="Focus this window, then scan. AgeCheck waits for 700 ms of silence and validates the complete frame. Internal line breaks do not submit a scan. A beep only means the scanner decoded something."/>
       <TextBlock Text="If a scan needs manual review" FontWeight="SemiBold" Margin="0,24,0,8"/>
       <TextBlock Text="Check keyboard layout, control-character output and the complete barcode. Pauses above 700 ms may require scanner configuration changes. Supported AAMVA versions: 08–10; USA and CAN. Other formats require manual review. Never share real ID barcodes in support reports."/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
      <TextBlock Text="Stay up to date." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,24"/>
      <Border Background="White" CornerRadius="18" Padding="28"><StackPanel>
       <TextBlock Text="AgeCheck for Windows" FontSize="21" FontWeight="SemiBold"/>
       <TextBlock x:Name="UpdateStatus" Text="Check for stable releases from the official repository." Margin="0,16,0,22"/>
       <CheckBox x:Name="StartupChecks" Content="Check for updates when AgeCheck starts" IsChecked="True" Click="StartupChecks_Click" Margin="0,0,0,24"/>
       <WrapPanel><Button x:Name="CheckButton" Content="Check for updates" Click="CheckUpdates_Click" Margin="0,0,10,10"/><Button x:Name="DownloadButton" Content="Download update" Click="Download_Click" IsEnabled="False" Margin="0,0,10,10"/><Button x:Name="RestartButton" Content="Update and restart" Click="Restart_Click" IsEnabled="False" Margin="0,0,0,10"/></WrapPanel>
       <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,20" Foreground="#176B53"/>
       <TextBlock Text="RELEASE NOTES" FontSize="11" FontWeight="Bold" Foreground="#64766D"/>
       <TextBlock x:Name="ReleaseNotes" Text="No update selected." Margin="0,12,0,24"/>
       <Button Content="Later — return to scanning" Click="ScanPage_Click" HorizontalAlignment="Left"/>
       <TextBlock Text="Downloads run in the background. Restart is always your choice. Offline scanning continues if update checks fail." Foreground="#64766D" Margin="0,24,0,0"/>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="1" BorderBrush="#D9E2DA" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><StackPanel><TextBlock Text="ID authenticity not verified." FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Compare the printed details, photograph and customer. A barcode check does not authorize a sale." FontSize="11" Foreground="#687B70" Margin="0,5,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
